{
  "name": "@arthurita/packets",
  "description": "Builders and utilities for Minecraft packets",
  "author": "Davi Patricio <davipatricio@pm.me>",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write --unsafe ."
