  },
  "dependencies": {
    "@arthurita/encoding": "workspace:*",
    "@arthurita/nbt": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5.7.1-rc"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.13"
  }
